# Copy to .env for local dev (`netlify dev` reads it). In production set all
# of these in Netlify → Site configuration → Environment variables.

# ─────────────── SERVER-ONLY — never prefix these with VITE_ ───────────────

# Same Stripe account as paola_book_sales. A restricted key (rk_live_…) is
# better than the full secret key. Permissions it needs:
#   Checkout Sessions: Write   (read orders + save fulfillment status in metadata)
#   PaymentIntents:    Write   (read refunds; mirror fulfillment status)
#   Charges:           Read    (refunds / disputes)
#   Products:          Read
#   Shipping rates:    Read
STRIPE_SECRET_KEY=rk_live_...

# Firebase project ID. Optional — falls back to VITE_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=

# Firebase Admin service account (Project settings → Service accounts →
# Generate new private key). OPTIONAL: signing in and the orders screens only
# need the project ID. These enable the superadmin account tools and
# revoked-token checks. In .env the key must be ONE line, in double quotes,
# with \n between lines (an unquoted multi-line paste only keeps line 1):
#   FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"
# (In the Netlify UI you can paste the multi-line key as-is.)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Who may use the dashboard. Comma-separated emails and/or Firebase UIDs.
# Keep self sign-up OFF in Firebase (Authentication → Settings → User actions).
# UIDs are the strictest option (Firebase console → Authentication → Users).
DASHBOARD_USERS=paola@example.com
# Superadmins can do everything a user can, plus the Setup screen.
DASHBOARD_SUPERADMINS=mckevitt.r@gmail.com

# ─────────────── CLIENT-SAFE — Firebase web app config ───────────────
# (Project settings → General → Your apps → Web app.) Public by design.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=

# Local testing only: point the app at the Firebase Auth emulator.
# VITE_FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
